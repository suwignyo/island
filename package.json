{
  "name": "life-island",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "api": "npm run start -w apps/api",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "e2e:update": "playwright test --trace off --update-snapshots",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "fast-check": "^4.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
